# Copie o conteúdo para um arquivo .env (na raiz do app) e ajuste ao ambiente.
# Somente URLs — NUNCA coloque senhas, tokens ou credenciais em variáveis
# EXPO_PUBLIC_: elas ficam embutidas no aplicativo e são visíveis a qualquer um.

# Desenvolvimento no computador (backend na mesma máquina, porta 8080):
# EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Expo Go em celular físico: IPv4 do computador na rede Wi-Fi
# (ip -4 addr show | grep 'inet ') — NÃO use localhost no celular:
# localhost aponta para o próprio celular.
EXPO_PUBLIC_API_URL=http://192.168.0.32:8080/api

# Emulador Android do Android Studio (10.0.2.2 equivale ao host):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# Produção (apenas quando o ambiente exigir):
# EXPO_PUBLIC_API_URL=https://backend-gerencia-0k9o.onrender.com/api
